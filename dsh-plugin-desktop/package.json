    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web-app": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "node-addon-require-builtin": "^0.1.4",
    "react": "18.3.1"
  },
  "peerDependencies": {
    "electron": "43.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "^18",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/icon.png",
      "cordis.patch.yml",
      "lib/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  }
