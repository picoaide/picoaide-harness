    "@deepseek-ai/dsh-client-ui-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.0-rc.6",
