{
  "name": "@picoaide/dsh-enterprise",
  "version": "0.1.0",
  "description": "Enterprise login + server-side LLM gateway for DSH Desktop",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./auth-gate": {
      "types": "./lib/types/auth-gate.d.ts",
      "default": "./lib/auth-gate.js"
    },
    "./gateway-model": {
      "types": "./lib/types/gateway-model.d.ts",
      "default": "./lib/gateway-model.js"
    },
    "./bootstrap": {
      "types": "./lib/types/bootstrap.d.ts",
      "default": "./lib/bootstrap.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "yarn run build && yarn run typecheck && yarn run test"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
