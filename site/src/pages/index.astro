---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Icon from '../components/Icon.astro'
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro'
import DeliveryDiagram from '../components/DeliveryDiagram.astro'
import logo from '../../../brands/official/logo.svg'
import logoDark from '../../../brands/official/logo-dark.svg'
import mainShot from '../assets/screenshots/desktop-main.png'
import capabilityShot from '../assets/screenshots/desktop-capability-market.png'
import connectorsShot from '../assets/screenshots/desktop-connectors.png'
import cronShot from '../assets/screenshots/desktop-cron.png'
import settingsShot from '../assets/screenshots/desktop-settings.png'
import adminUsersShot from '../assets/screenshots/admin-users.png'
import adminCapabilityShot from '../assets/screenshots/admin-capabilities.png'
import adminGatewayShot from '../assets/screenshots/admin-gateway.png'
import adminUsageShot from '../assets/screenshots/admin-usage.png'
import adminAuditShot from '../assets/screenshots/admin-audit.png'
import adminServerShot from '../assets/screenshots/admin-server-info.png'

// 更新说明：取最新 3 篇博客。
const updates = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)

// 三层架构：桌面客户端 / 本地智能体引擎 / 企业服务端。
// 这三张卡是首页的"骨架"——每一层都列出该层真正负责的事，不写形容词。
const layers = [
  {
    kicker: 'Desktop',
    title: '桌面客户端',
    body: '原生窗口、系统托盘、自动更新。对话、能力中心、连接器、定时任务、内置浏览器与语音输入都在一个界面里完成。',
    ticks: [
      '安装包自带 Node.js / pnpm / Python 运行时，员工机器不需要任何开发环境',
      '关闭窗口只是收进托盘；诊断包一键导出',
      '连接器凭据、浏览器会话、定时任务按账号隔离',
    ],
  },
  {
    kicker: 'Local host',
    title: '本地智能体引擎',
    body: '自动启动、停止与恢复本地 Harness 服务，会话、文件与工作区留在本机；模型请求经企业网关转发。',
    ticks: [
      '上游 DeepSeek Harness 以固定版本原样运行，不魔改源码',
      '桌面壳与业务插件按官方 Cordis 机制组合，可替换、可演进',
      '沙箱按会话分档：只读 / 工作区内修改 / 完全权限',
    ],
  },
  {
    kicker: 'Server',
    title: '企业服务端与管理后台',
    body: '一台内网服务器承载账号、模型网关、额度计费、能力中心审批与审计，管理后台随镜像内嵌。',
    ticks: [
      '上游模型密钥 AES-GCM 加密后只存服务端，员工拿不到任何 API Key',
      '客户端安装包与升级包由这台服务器下发',
      '员工接触不到管理后台：它在 /admin/，按 RBAC 权限点显示',
    ],
  },
]

// AI 水位阶梯：多数企业的 AI 落地卡在「个人用得不错、组织拿不到」这一步。
// 这一版块的写法是刻意的 —— 先写每一级的典型特征（企业能自评），再写平台在该级提供什么。
const levels = [
  {
    title: '个人尝鲜',
    note: '员工各自用外部工具，数据出企业，成本是一笔糊涂账。',
    provides: ['客户端随服务端分发，员工只访问企业域名', '上游模型密钥只在服务端，员工机器上没有任何 Key'],
  },
  {
    title: '部门试点',
    note: '每个部门各接一套，成果无法横向复制。',
    provides: ['统一模型网关与模型目录：接新模型是改配置，不是改代码', '能力中心按用户或部门授权，不再各自造轮子'],
  },
  {
    title: '平台化复用',
    note: '技能、智能体与应用变成可检索、可审批、可复用的资产。',
    provides: [
      '能力中心：员工上传 → 管理员审批 → 全员复用，归属清晰',
      '五轨记忆：项目经验按目录与分支沉淀，跟着项目走',
      '应用中心：业务自己造的小工具，全员可直接打开',
    ],
  },
  {
    title: '可度量的 AI 原生',
    note: '管理层看得到水位：谁在用、用在哪、花了多少、哪些能力被复用了。',
    provides: ['用量中心按部门 / 成员 / 模型拆账，账本可逐笔对账', '余额闸门与审计日志：成本可控、行为可回溯'],
  },
]

// 能力矩阵：员工每天真的会打开的东西。
const capabilities = [
  {
    icon: 'chat',
    title: '智能对话与工作区',
    body: '每条会话绑定一个项目目录；模型读写文件、执行命令、操作浏览器时按权限门控逐次确认。',
  },
  {
    icon: 'grid',
    title: '能力中心',
    body: '技能与智能体两类内容，我的 / 市场两个来源；安装、更新、卸载与上传审核状态一站可见。',
  },
  {
    icon: 'link',
    title: '连接器中心',
    body: '用一条标准 MCP 配置接入企业内部系统，OAuth 授权与令牌续期自动完成，凭据加密留在本机。',
  },
  {
    icon: 'clock',
    title: '定时任务',
    body: 'cron + 提示词 + 工作区 + 智能体预设，到点自动执行；每次执行的会话、结果与错误随时可查。',
  },
  {
    icon: 'browser',
    title: '内置浏览器',
    body: 'Agent 可接管浏览器完成操作：多标签、地址栏、下载管控与操作日志；控制权只在「我来操作」按钮上交接。',
  },
  {
    icon: 'mic',
    title: '语音输入',
    body: '说话转成输入框草稿；识别在本机子进程里跑，音频不出机器、离线可用，模型随客户端分发。',
  },
  {
    icon: 'layers',
    title: '五轨记忆',
    body: '用户档案 / 全局事实 / 项目关键记忆 / 项目日志 / 每日日志，按目录与 git 分支隔离，确认制写入。',
  },
  {
    icon: 'cube',
    title: '应用中心',
    body: '员工用 AI 自建 WASM 应用，只在客户端独立窗口打开；服务端不需要为应用准备任何公网入口与证书。',
  },
]

// 企业管控面：管理员真正会配置的东西。
const controlPoints = [
  {
    title: '账号与认证',
    body: '本地账号、LDAP、OIDC 三种登录方式；管理员 MFA。改密、降权、禁用即时吊销该账号全部令牌。',
  },
  {
    title: '模型网关',
    body: '上游供应商与模型目录由管理员统一配置，可标注输入模态；密钥加密存储，客户端只看到一个模型清单。',
  },
  {
    title: '用量与计费',
    body: '按用户按模型计量输入/输出与缓存命中，支持高峰时段分级定价；余额闸门与可逐笔对账的账本。',
  },
  {
    title: '审批与授权',
    body: '共享技能与智能体走统一审批队列，官方与精选内容带徽章；授权对象可以是用户或部门。',
  },
  {
    title: '审计日志',
    body: '用户、部门、网关、能力中心与共享审批的关键操作全程留痕，哈希链防篡改，保留策略可配。',
  },
  {
    title: '服务器信息',
    body: '版本、更新提示、数据库与迁移状态、模型并发一屏可查；升级前先备份，回滚只需切回旧镜像。',
  },
]

// 安全与数据主权：每条都对应一个可验证的实现，而不是形容词。
const security = [
  {
    icon: 'key',
    title: '凭据加密存储',
    body: '上游密钥以 AES-GCM 加密（密文前缀 enc:v1:，主密钥独立成文件）；凭据按 0600/0700 权限原子写入，防符号链接与路径逃逸。',
  },
  {
    icon: 'hash',
    title: '令牌只存哈希',
    body: '员工 API 令牌 90 天过期且只存哈希；改密、降权、禁用与用户更新同事务吊销。管理端会话 12 小时硬上限 + 空闲滑动过期 + CSRF。',
  },
  {
    icon: 'shield',
    title: '沙箱与权限分档',
    body: '会话可选只读 / 工作区内修改 / 完全权限；写操作受工作区与临时目录约束（Linux Landlock、Windows ACL），越界即拒绝。',
  },
  {
    icon: 'outbound',
    title: '出站边界',
    body: '客户端默认不读取系统代理，升级源只有它登录的那台服务器；未连接服务端时不做任何外发检查，内网可完全离线。',
  },
  {
    icon: 'ban',
    title: '严格默认拒绝',
    body: '未授权的市场与共享内容一律 404（不泄露存在性）；授权变更留痕；管理员操作经 RBAC 与审计双重约束。',
  },
  {
    icon: 'database',
    title: '数据主权',
    body: '数据、密钥与账本都在企业自己的机器上（bind mount 目录），随镜像交付，没有按人头授权费，也不需要把数据交给第三方。',
  },
]

const faqs = [
  {
    q: 'PicoAide Harness 与 DeepSeek Harness 的关系？',
    a: '上游 DeepSeek Harness 提供核心智能体、插件系统与 Web UI；本项目提供桌面封装、本地服务启动与企业服务端，基于固定版本构建，不魔改上游源码。桌面壳自身就是一个合法的 DSH 插件。',
  },
  {
    q: '支持私有化部署吗？',
    a: '支持，且是主要形态。交付物是一个容器镜像（含服务端、内置 PostgreSQL、Caddy 与三平台客户端安装包），可选三种证书模式，数据全部落在部署目录的 bind mount 里；也支持并入已有反代或单二进制 + 外部 PostgreSQL。',
  },
  {
    q: '员工电脑需要访问外网吗？',
    a: '不需要。客户端从企业自己的服务器下载与升级，员工机器只与企业域名通信；完全隔离的环境可以离线旁路取包部署。',
  },
  {
    q: '客户端怎么升级？',
    a: '升级服务端即可。客户端安装包随服务端镜像发布，客户端定期向它登录的服务器检查新版本，并按清单里的 SHA-256 校验后安装——不存在「客户端升了、服务端没升」的错配。',
  },
  {
    q: '模型和密钥放在哪？',
    a: '模型目录与上游 API Key 由管理员在管理后台配置，密钥在服务端加密存储，客户端只拿到一个模型清单与会话令牌，员工机器上没有任何上游 Key。',
  },
  {
    q: '连接器与技能如何分发？',
    a: '遵循「技能 + MCP」两种标准形态：企业能力以 SKILL.md 经能力中心分发（审批 + 授权），MCP 能力走连接器框架，一条标准配置即可接入；两者都可审计、可审批、可收回。',
  },
  {
    q: '是否开源？',
    a: '本项目遵循 MIT License，完全开源免费。上游以固定版本原样运行，升级只跟随上游版本号。',
  },
  {
    q: '支持哪些平台？',
    a: 'Windows x64（NSIS 安装程序）、macOS（Apple 芯片，DMG，正式版已签名与公证）与 Linux x64（AppImage）；企业交付面不含 Linux deb。',
  },
]
---

<Layout
  title="PicoAide Harness — 企业级 AI 一体化平台"
  description="PicoAide Harness：桌面客户端、本地智能体引擎与企业服务端三层一体。一个容器镜像完成私有化部署，客户端随服务端发布，员工机器不访问任何外网。"
>
  <Header />

  <!-- ── Hero ───────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__brand">
        <picture>
          <source srcset={logoDark.src} media="(prefers-color-scheme: dark)" />
          <img src={logo.src} alt="PicoAide Harness" width="52" height="52" class="hero__logo" />
        </picture>
        <span class="hero__brandname">PicoAide Harness</span>
      </div>

      <h1 class="hero__title">把 AI 从个人技巧<br />变成<em>组织能力</em></h1>

      <p class="hero__sub">
        员工在客户端里干活，做出来的技能与智能体可以共享给全员；用量、额度与审计留在企业自己的服务器上。
        交付物是一个容器镜像：服务端、内置 PostgreSQL、反向代理与三平台客户端安装包都在里面，
        员工机器不需要访问任何外网。
      </p>

      <div class="actions actions--center">
        <a class="btn btn--accent" href="/deployment/">私有化部署指南<span class="btn__arrow">→</span></a>
        <a class="btn btn--ghost" href="/getting-started/">快速开始</a>
        <a class="btn btn--ghost" href="#adoption">AI 水位自评</a>
      </div>

      <div class="fact-strip hero__facts">
        <div class="fact">
          <div class="fact__k">交付物</div>
          <div class="fact__v">一个容器镜像</div>
          <div class="fact__n">服务端 + 数据库 + 客户端</div>
        </div>
        <div class="fact">
          <div class="fact__k">员工侧</div>
          <div class="fact__v">零外网</div>
          <div class="fact__n">只访问企业域名，安装与升级同源</div>
        </div>
        <div class="fact">
          <div class="fact__k">组织侧</div>
          <div class="fact__v">经验可复用</div>
          <div class="fact__n">共享技能、智能体与应用</div>
        </div>
        <div class="fact">
          <div class="fact__k">管理侧</div>
          <div class="fact__v">水位可度量</div>
          <div class="fact__n">用量、余额与审计一屏可查</div>
        </div>
      </div>

      <Image class="hero__shot" src={mainShot} alt="PicoAide Harness 桌面客户端主界面" width={1120} height={711} format="webp" quality={82} />
    </div>
  </section>

  <!-- ── AI 水位阶梯 ────────────────────────────────────────────────────── -->
  <section class="section" id="adoption">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Adoption</span>
        <h2 class="section__title">企业 AI 水位：从个人技巧到组织能力</h2>
        <p class="section__sub">
          大多数企业卡在同一处 —— 个人用得不错，组织拿不到。这套平台要解决的正是后面三步：
          让经验沉淀、让能力复用、让水位看得见。
        </p>
      </div>

      <div class="grid grid--4">
        {levels.map((level, index) => (
          <article class={`card level-card${index >= 2 ? ' level-card--on' : ''}`}>
            <div class="level-card__step">L{index + 1}</div>
            <h3>{level.title}</h3>
            <p class="level-card__note">{level.note}</p>
            <div class="level-card__label">平台提供</div>
            <ul class="ticks">
              {level.provides.map(item => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <p class="section__more">
        <a href="/desktop/">能力中心与记忆如何工作</a>
        <span>·</span>
        <a href="/admin/">管理员看到的用量与审计</a>
        <span>·</span>
        <a href="/apps/">员工自建应用</a>
      </p>
    </div>
  </section>

  <!-- ── 三层协同 ───────────────────────────────────────────────────────── -->
  <section class="section" id="platform">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Architecture</span>
        <h2 class="section__title">一个平台，三层协同</h2>
        <p class="section__sub">
          客户端负责交互，本地服务负责智能体运行，服务端负责账号、模型与审计。
          三层各自独立升级，接口只有一套。
        </p>
      </div>

      <div class="grid grid--3">
        {layers.map(layer => (
          <article class="card layer">
            <div class="layer__kicker">{layer.kicker}</div>
            <h3>{layer.title}</h3>
            <p>{layer.body}</p>
            <ul class="ticks">
              {layer.ticks.map(tick => <li>{tick}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <figure class="diagram-frame">
        <div class="diagram-scroll">
          <ArchitectureDiagram locale="root" />
        </div>
        <figcaption>
          数据流与信任边界：员工机器只需要与企业内网服务器通信，上游密钥不出服务端。
          <span class="scroll-hint">（窄屏可左右滑动查看完整示意图）</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ── 能力矩阵 ───────────────────────────────────────────────────────── -->
  <section class="section section--soft" id="capabilities">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">Capabilities</span>
        <h2 class="section__title">员工每天会用到的能力</h2>
        <p class="section__sub">
          开箱即用，不需要装插件市场里的第三方扩展；每一项都由服务端统一配置与审计。
        </p>
      </div>

      <div class="surface-grid">
        {capabilities.map(item => (
          <article class="surface">
            <span class="surface__icon"><Icon name={item.icon} size={18} /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>

      <p class="section__more">
        <a href="/desktop/">桌面客户端文档</a>
        <span>·</span>
        <a href="/plugin-development/">插件开发</a>
        <span>·</span>
        <a href="/plugin-ecosystem/">插件生态</a>
      </p>

      <div class="role-grid">
        <a class="card card--link role" href="/desktop/">
          <div class="role__who">我是员工</div>
          <h3>从登录到日常</h3>
          <p>会话与工作区、能力中心、连接器、定时任务、内置浏览器、语音输入与五轨记忆。</p>
          <span class="card__link">桌面客户端说明<span class="btn__arrow">→</span></span>
        </a>
        <a class="card card--link role" href="/admin/">
          <div class="role__who">我是管理员</div>
          <h3>从账号到水位</h3>
          <p>账号与认证、模型目录、额度与计费、能力中心审批、用量与审计。</p>
          <span class="card__link">企业管控面说明<span class="btn__arrow">→</span></span>
        </a>
        <a class="card card--link role" href="/deployment/">
          <div class="role__who">我是 IT / 运维</div>
          <h3>从部署到升级</h3>
          <p>一个镜像完成部署、升级与回滚；离线部署、渠道交付与排障。</p>
          <span class="card__link">部署与运维指南<span class="btn__arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── 企业管控面 ─────────────────────────────────────────────────────── -->
  <section class="section" id="control">
    <div class="container grid grid--split">
      <div>
        <span class="eyebrow">Admin console</span>
        <h2 class="section__title">账号、模型、额度与审计，都在一台内网服务器上</h2>
        <p class="section__sub">
          管理后台随服务端镜像内嵌（<code>/admin/</code>），侧栏按当前账号的 RBAC 权限点显示：
