---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import logo from '../assets/logo.svg'
import chatShot from '../assets/screenshots/desktop-chat.png'
import connectorsShot from '../assets/screenshots/desktop-connectors.png'
import skillsShot from '../assets/screenshots/desktop-skills.png'
import cronShot from '../assets/screenshots/desktop-cron.png'
import adminUsersShot from '../assets/screenshots/admin-users.png'
import adminGatewayShot from '../assets/screenshots/admin-gateway.png'
import adminUsageShot from '../assets/screenshots/admin-usage.png'
import adminAuditShot from '../assets/screenshots/admin-audit.png'
import desktopMainShot from '../assets/screenshots/desktop-main.png'

// 更新说明：取最新 3 篇博客
const updates = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<Layout title="PicoAide Harness - 企业级 AI 一体化平台" description="PicoAide Harness：桌面客户端、本地智能体引擎与管理后台，支持私有化部署的企业级 DeepSeek Harness 平台。">
  <Header />

  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__brand">
        <Image src={logo} alt="PicoAide Harness" width={56} height={56} class="hero__logo" />
        <span class="hero__brandname">PicoAide Harness</span>
      </div>
      <h1 class="hero__title">让每位员工拥有<br />自己的 AI 操作助手</h1>
      <p class="hero__sub">
        PicoAide Harness 将桌面客户端、本地智能体引擎与管理后台整合为一个平台。
        开箱即用，数据留在本机，适合企业内部署的 AI 工作底座。
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#features">了解产品</a>
        <a class="btn btn--ghost" href="#screenshots">查看截图</a>
      </div>
      <Image class="hero__shot" src={desktopMainShot} alt="PicoAide Harness 桌面主界面" width={1120} height={711} format="webp" quality={80} />
    </div>
  </section>

  <!-- 特性 -->
  <section class="section section--soft" id="features">
    <div class="container">
      <h2 class="section__title">企业级 AI 一体化平台</h2>
      <p class="section__sub">桌面客户端、本地服务与管理后台三层协同，开箱即用。</p>

      <div class="features">
        <div class="feature">
          <h3>桌面客户端</h3>
          <p>原生窗口、系统托盘、终端与自动更新。对话、记忆、连接器、技能、定时任务一站式完成，无需安装 Node.js。</p>
        </div>
        <div class="feature">
          <h3>本地智能体引擎</h3>
          <p>自动启动、停止与恢复本地 Harness 服务，数据留在本机。上游 DeepSeek Harness 以固定版本原样运行，不魔改源码。</p>
        </div>
        <div class="feature">
          <h3>管理后台</h3>
          <p>Web 化管理台覆盖用户、部门、网关、用量、商城与审计。按用户按模型计费、限额与豁免，高峰时段自动分级计价。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 截图墙 -->
  <section class="section" id="screenshots">
    <div class="container">
      <h2 class="section__title">界面预览</h2>
      <p class="section__sub">以下为产品真实界面截图。</p>

      <h3 class="gallery__group">桌面客户端</h3>
      <div class="gallery">
        <figure>
          <Image src={chatShot} alt="对话与记忆" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>对话与五轨记忆</figcaption>
        </figure>
        <figure>
          <Image src={connectorsShot} alt="连接器中心" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>连接器中心：销售易、钉钉、北森、飞书、Moka、企业微信</figcaption>
        </figure>
        <figure>
          <Image src={skillsShot} alt="技能中心" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>技能中心：一键安装 code-review 等技能</figcaption>
        </figure>
        <figure>
          <Image src={cronShot} alt="定时任务" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>定时任务：指定智能体、提示词与执行详情</figcaption>
        </figure>
      </div>

      <h3 class="gallery__group">管理后台</h3>
      <div class="gallery">
        <figure>
          <Image src={adminUsersShot} alt="用户管理" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>用户管理：账号、部门、角色与状态</figcaption>
        </figure>
        <figure>
          <Image src={adminGatewayShot} alt="网关配置" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>网关配置：模型、限流、配额与高峰时段</figcaption>
        </figure>
        <figure>
          <Image src={adminUsageShot} alt="用量统计" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>用量统计：费用、请求数与 Token 明细</figcaption>
        </figure>
        <figure>
          <Image src={adminAuditShot} alt="审计日志" width={640} height={400} loading="lazy" format="webp" quality={75} />
          <figcaption>审计日志：关键操作全程留痕</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 为什么选择 -->
  <section class="section section--soft" id="why">
    <div class="container">
      <h2 class="section__title">为什么选择 PicoAide Harness</h2>
      <p class="section__sub">安全、可扩展、完全可控。</p>
      <div class="features features--4">
        <div class="feature">
          <h3>安全合规</h3>
          <p>凭据以 0600/0700 权限原子写入，防符号链接与路径逃逸；OAuth state 校验；操作审计全程留痕。</p>
        </div>
        <div class="feature">
          <h3>多用户隔离</h3>
          <p>连接器凭据、浏览器会话、定时任务按账号隔离，退出登录即解除所有会话。</p>
        </div>
        <div class="feature">
          <h3>一切皆插件</h3>
          <p>核心智能体、Web UI、桌面外壳、连接器、任务与记忆全部通过官方 Cordis 插件机制组合，可替换、可演进。</p>
        </div>
        <div class="feature">
          <h3>私有化部署</h3>
          <p>数据留在本机，企业内网部署，不依赖外部云服务，完全掌控自己的 AI 底座。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 私有化部署 -->
  <section class="section" id="deployment">
    <div class="container">
      <h2 class="section__title">私有化部署</h2>
      <p class="section__sub">PicoAide Harness 面向企业内网部署，开箱即用。</p>
      <div class="steps">
        <div class="step">
          <span class="step__num">1</span>
          <h3>准备环境</h3>
          <p>安装桌面客户端，或在内网服务器部署本地服务。</p>
        </div>
        <div class="step">
          <span class="step__num">2</span>
          <h3>配置网关</h3>
          <p>配置模型网关、限流、配额与高峰时段策略。</p>
        </div>
        <div class="step">
          <span class="step__num">3</span>
          <h3>接入全员</h3>
          <p>创建用户与部门，分配角色与配额，员工开箱即用。</p>
        </div>
      </div>
      <p class="deployment__note">如需获取企业版部署方案，请前往 GitHub 仓库 <a href="https://github.com/picoaide/picoaide-harness" target="_blank" rel="noopener">picoaide/picoaide-harness</a> 提交 Issue。</p>
    </div>
  </section>

  <!-- 更新说明 -->
  <section class="section" id="updates">
    <div class="container container--narrow">
      <h2 class="section__title">更新说明</h2>
      <p class="section__sub">了解最新版本的功能与改进。</p>

      <div class="updates">
        {updates.map((update, index) => (
          <a href={`/blog/${update.id}/`} class="update">
            <div class="update__meta">
              <span class="update__badge">v{update.data.version ?? ''}</span>
              <time class="update__time" datetime={update.data.pubDate.toISOString()}>
                {update.data.pubDate.toLocaleDateString('zh-CN')}
              </time>
            </div>
            <h3 class="update__title">{update.data.title}</h3>
            {update.data.description && <p class="update__desc">{update.data.description}</p>}
          </a>
        ))}
      </div>

      <p class="updates__more">
        查看全部更新 <a href="/blog/">前往博客</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft" id="faq">
    <div class="container container--narrow">
      <h2 class="section__title">常见问题</h2>

      <details class="faq">
        <summary>PicoAide Harness 与 DeepSeek Harness 的关系？</summary>
        <p>上游 DeepSeek Harness 提供核心智能体、插件系统与 Web UI；本项目提供桌面封装、本地服务与管理后台，基于固定版本构建，不魔改上游源码。</p>
      </details>
      <details class="faq">
        <summary>是否支持私有化部署？</summary>
        <p>支持。数据留在本机，可部署于企业内网，不依赖外部云服务。企业版部署方案请通过 GitHub Issue 联系。</p>
      </details>
      <details class="faq">
        <summary>是否开源？</summary>
        <p>本项目遵循 MIT License，完全开源免费。</p>
      </details>
      <details class="faq">
        <summary>支持哪些平台？</summary>
        <p>支持 Windows x64、macOS Apple Silicon 与 Linux x64。</p>
      </details>
    </div>
  </section>

  <Footer />

  <style>
    .hero {
      padding: 72px 0 0;
      text-align: center;
      background: linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
    }

    .hero__brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .hero__logo {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      box-shadow: var(--shadow);
    }

    .hero__brandname {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    .hero__title {
      font-size: clamp(2.2rem, 6vw, 3.6rem);
      margin: 0 0 18px;
      font-weight: 800;
    }

    .hero__sub {
      color: var(--ink-soft);
      max-width: 620px;
      margin: 0 auto 32px;
      font-size: 1.12rem;
    }

    .hero__actions {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-bottom: 56px;
    }

    .hero__shot {
      width: 100%;
      max-width: 1040px;
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--line);
      margin-bottom: -1px;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .features--4 {
      grid-template-columns: repeat(4, 1fr);
    }

    .feature {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px 24px;
      box-shadow: var(--shadow);
    }

    .feature h3 {
      margin: 0 0 10px;
      font-size: 1.12rem;
    }

    .feature p {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.96rem;
    }

    .gallery__group {
      margin: 40px 0 16px;
      font-size: 1.2rem;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .step {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px 24px;
      text-align: center;
    }

    .step__num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--brand);
      color: #fff;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .step h3 {
      margin: 0 0 8px;
      font-size: 1.05rem;
    }

    .step p {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.94rem;
    }

    .deployment__note {
      text-align: center;
      color: var(--ink-soft);
      margin-top: 36px;
    }

    .container--narrow {
      max-width: 760px;
    }

    .updates {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .update {
      display: block;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: #fff;
      padding: 20px 24px;
      color: var(--ink);
      text-decoration: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .update:hover {
      border-color: var(--brand);
      box-shadow: var(--shadow);
    }

    .update__meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 8px;
    }

    .update__badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      background: var(--brand);
      color: #fff;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .update__time {
      color: var(--ink-faint);
      font-size: 0.88rem;
    }

    .update__title {
      margin: 0 0 6px;
      font-size: 1.1rem;
    }

    .update__desc {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.95rem;
    }

    .updates__more {
      text-align: center;
      color: var(--ink-soft);
      margin-top: 28px;
      font-size: 0.95rem;
    }

    .faq {
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: #fff;
      padding: 16px 20px;
      margin-bottom: 12px;
    }

    .faq summary {
      cursor: pointer;
      font-weight: 600;
      font-size: 1.02rem;
    }

    .faq p {
      margin: 12px 0 0;
      color: var(--ink-soft);
    }

    @media (max-width: 860px) {
      .features,
      .features--4,
      .steps {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
