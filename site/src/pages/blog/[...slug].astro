---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Layout title={`${post.data.title} - PicoAide Harness`} description={post.data.description}>
  <Header />

  <article>
    <header class="page-head">
      <div class="container container--narrow">
        <div class="post-page__meta">
          {post.data.version && <span class="update__badge">v{post.data.version}</span>}
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN')}
          </time>
          {post.data.author && <span>· {post.data.author}</span>}
        </div>
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="page-head__lead">{post.data.description}</p>}
        {post.data.tags.length > 0 && (
          <div class="tag-row post-page__tags">
            {post.data.tags.map(tag => <span class="badge">{tag}</span>)}
          </div>
        )}
      </div>
    </header>

    <div class="container container--narrow section prose">
      <Content />
    </div>
  </article>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <h2>准备在自己内网跑起来？</h2>
      <p>部署指南可以直接交给运维或 AI 执行：取镜像、导出部署文件、写完 .env 即完成。</p>
      <div class="actions actions--center">
        <a class="btn btn--light" href="/deployment/">阅读部署指南<span class="btn__arrow">→</span></a>
        <a class="btn btn--ghost-light" href="/blog/">返回博客</a>
      </div>
    </div>
  </section>

  <Footer />

  <style>
    .post-page__meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      color: var(--ink-4);
      font-size: 0.88rem;
      margin-bottom: 12px;
    }

    .post-page__tags {
      margin-top: 18px;
    }

    /* 正文区块在 .prose 基础上只补这一页特有的间距（其余在 global.css） */
    .prose :global(h2) {
      font-size: 1.42rem;
    }

    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.4em 0;
      font-size: 0.94rem;
    }

    .prose :global(th),
    .prose :global(td) {
      border: 1px solid var(--line);
      padding: 10px 14px;
      text-align: left;
    }

    .prose :global(th) {
      background: var(--bg-soft);
    }
  </style>
</Layout>
