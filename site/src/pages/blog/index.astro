---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

/**
 * 博客索引。视觉与首页更新说明卡同一套语言（card / badge / update__*），
 * 只是这里把摘要与标签也一并展示。
 */
---

<Layout title="博客 - PicoAide Harness" description="PicoAide Harness 产品动态、技术文章与最佳实践。">
  <Header />

  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Changelog</span>
      <h1>博客</h1>
      <p class="page-head__lead">产品动态、版本说明与技术文章。每个版本都带策展的发布说明：谁必须升级、不升级会怎样。</p>
    </div>
  </section>

  <main class="section">
    <div class="container container--narrow">
      {posts.length === 0 && <p class="empty">暂无文章。</p>}

      <div class="posts">
        {posts.map(post => (
          <article class="post">
            <div class="post__meta">
              {post.data.version && <span class="update__badge">v{post.data.version}</span>}
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN')}
              </time>
              {post.data.author && <span class="post__author">{post.data.author}</span>}
            </div>
            <h2 class="post__title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            {post.data.description && <p class="post__desc">{post.data.description}</p>}
            {post.data.tags.length > 0 && (
              <div class="tag-row post__tags">
                {post.data.tags.map(tag => <span class="badge">{tag}</span>)}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />

  <style>
    .posts {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .post {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r);
      padding: 24px 26px;
      box-shadow: var(--shadow-xs);
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }

    .post:hover {
      border-color: var(--accent-line);
      box-shadow: var(--shadow);
      transform: translateY(-2px);
    }

    .post__meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      color: var(--ink-4);
      font-size: 0.86rem;
      margin-bottom: 10px;
    }

    .post__author::before {
      content: '·';
      margin-right: 8px;
      color: var(--ink-4);
    }

    .post__title {
      margin: 0 0 8px;
      font-size: 1.24rem;
      letter-spacing: -0.02em;
    }

    .post__title a {
      color: var(--ink);
    }

    .post__title a:hover {
      color: var(--accent-strong);
    }

    .post__desc {
      color: var(--ink-3);
      margin: 0 0 14px;
      font-size: 0.95rem;
    }

    .empty {
      color: var(--ink-4);
    }
  </style>
</Layout>
