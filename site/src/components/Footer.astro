---
import logoDark from '../../../brands/official/logo-dark.svg'
import { footerContent } from './site-nav.mjs'

/**
 * 页脚。**站内链接一律来自 `./site-nav.mjs`**（与 Header 同一条纪律：模板里不留 href 字面量）。
 *
 * 深色底用 `--panel-*` 令牌（与主题模式解耦），品牌 mark 用 `logo-dark.svg`
 * （白底版）—— AGENTS 的强制双色规则：深色面用 dark 变体，不要在深色底上用黑底白纹那份。
 *
 * `locale` 缺省 `root` = 中文站；英文页必须传 `locale="en"`（判据同 Header）。
 */
interface Props {
  locale?: 'root' | 'en'
}

const { locale = 'root' } = Astro.props
const content = footerContent(locale)
const year = new Date().getFullYear()
const isEn = locale === 'en'
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <div class="footer__brandrow">
        <img src={logoDark.src} alt="" width="30" height="30" class="footer__logo" />
        <strong>PicoAide Harness</strong>
      </div>
      <p>{content.tagline}</p>
      <div class="footer__badges">
        <span class="badge">{isEn ? 'MIT licensed' : 'MIT 开源'}</span>
        <span class="badge">{isEn ? 'Self-hosted' : '私有化部署'}</span>
        <span class="badge">{isEn ? 'Upstream pinned' : '上游固定版本'}</span>
      </div>
    </div>

    {content.groups.map(group => (
      <div class="footer__col">
        <strong>{group.title}</strong>
        <ul>
          {group.links.map(link => (
            <li>
              <a
                href={link.href}
                target={link.blank ? '_blank' : undefined}
                rel={link.blank ? 'noopener' : undefined}
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="container footer__bottom">
    <span>© {year} PicoAide. All rights reserved.</span>
    <span class="footer__note">{content.note}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--panel);
    color: var(--panel-ink-2);
    padding: clamp(48px, 6vw, 72px) 0 26px;
    border-top: 1px solid var(--panel-line);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: 36px 28px;
  }

  .footer__brandrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .footer__logo {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  .footer__brand strong {
    color: var(--panel-ink);
    font-size: 1.02rem;
    letter-spacing: -0.01em;
  }

  .footer__brand p {
    margin: 0 0 16px;
    color: var(--panel-ink-2);
    font-size: 0.92rem;
    max-width: 34ch;
  }

  .footer__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer__badges .badge {
    color: var(--panel-ink-2);
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--panel-line);
  }

  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__col strong {
    display: block;
    color: var(--panel-ink);
    font-size: 0.83rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: var(--font-mono);
    font-weight: 600;
    margin-bottom: 16px;
  }

  .footer__col a {
    color: var(--panel-ink-2);
    font-size: 0.92rem;
  }

  .footer__col a:hover {
    color: #fff;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 22px;
    border-top: 1px solid var(--panel-line);
    color: var(--panel-ink-3);
    font-size: 0.86rem;
  }

  .footer__note {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  @media (max-width: 1080px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .footer__bottom {
      justify-content: flex-start;
    }
  }
</style>
