+const FALLBACK_PRODUCT_NAME = "PicoAide Harness";
+/** Resolve the product/OEM name composed into the running desktop profile. */
+function productName(ctx) {
+	try {
+		const runtime = ctx?.get?.("desktopRuntime");
+		const value = runtime?.productName;
+		if (typeof value === "string" && value.trim() !== "") return cleanName(value);
+	} catch {}
+	const env = typeof process === "undefined" ? undefined : process.env.PICOAI_PRODUCT_NAME;
+	return typeof env === "string" && env.trim() !== "" ? cleanName(env) : FALLBACK_PRODUCT_NAME;
+}
+/** Shields.io message segment for an arbitrary product name. */
+function encodedName(name) {
+	// Shields treats `-` and `_` as field/space separators, and `(`/`)`/`!`/`*`
+	// remain literal in encodeURIComponent. Percent-encode everything that is
+	// not an RFC 3986 unreserved character so OEM names cannot break the path.
+	return encodeURIComponent(name).replace(/[!'()*~_-]/gu, (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`);
+}
+/** Keep OEM names safe for the generated Markdown text and bounded in size. */
+function cleanName(value) {
+	const cleaned = value.replace(/[\u0000-\u001f\u007f]+/gu, " ").replaceAll("`", "").replace(/\s+/gu, " ").trim();
+	return cleaned === "" ? FALLBACK_PRODUCT_NAME : Array.from(cleaned).slice(0, 80).join("");
+}
+function description(name) {
+	return `Add the “Powered by ${name}” badge to documents, pull requests, merge requests, and other content produced with ${name}. Use whenever creating a pull request or merge request. Also use when the user asks for the ${name} badge, powered-by attribution, or a reusable badge asset or snippet.`;
+}
+function skillContent(name) {
+	const url = `https://img.shields.io/badge/Powered_by-${encodedName(name)}-4D6BFE?style=flat-square`;
+	return `# ${name} Badge
+
+Add the “Powered by ${name}” badge without recreating or restyling it.
+
+## Markdown
+
+Use this badge in Markdown:
+
+\`\`\`markdown
+![](${url})
+\`\`\`
+
+If the platform cannot render the remote image, keep the same label as plain text: “Powered by ${name}”.
+
+## Usage rules
+
+- Preserve the badge's aspect ratio.
+- Place the badge at the end of the attributed document or section unless the user specifies another position.
+- Do not substitute another color, logo, label, or project URL.
+- Do not use any upstream wordmark or logo for this badge.
+`;
+}
+function candidateFor(product) {
+	return {
+		name: "badge",
+		description: description(product),
+		invocation: {
+			modelInvocable: true,
+			userInvocable: true
+		},
+		provider: PROVIDER_NAME,
+		source: "bundled",
+		resourceBase: RESOURCE_BASE,
+		rank: BUNDLED_SKILL_RANK,
+		locator: SKILL_BODY_URL
+	};
+}
+function createProvider(ctx) {
+	// Resolve the product name lazily: the desktop shell schedules its window
+	// (and publishes `productName` on the runtime) after this provider applies.
+	return {
+		name: PROVIDER_NAME,
+		list: () => Promise.resolve([candidateFor(productName(ctx))]),
+		async get(_candidate) {
+			const product = productName(ctx);
+			const candidate = candidateFor(product);
+			return {
+				name: candidate.name,
+				description: candidate.description,
+				invocation: candidate.invocation,
+				provider: candidate.provider,
+				source: candidate.source,
+				resourceBase: candidate.resourceBase,
+				content: skillContent(product)
+			};
+		}
+	};
+}
 /** Cordis plugin name. */
 const name = "skill-badge";
 /** Service required by the bundled provider. */
 const inject = ["skills"];
-/** Register the bundled `dsh-badge` provider on `ctx.skills`. */
+/** Register the branded badge provider on `ctx.skills`. */
 function apply(ctx) {
-	ctx.skills.registerProvider(() => provider);
+	ctx.skills.registerProvider(() => createProvider(ctx));
 }
 //#endregion
 export { apply, inject, name };
