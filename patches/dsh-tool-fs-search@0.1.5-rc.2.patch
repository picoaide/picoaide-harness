+/**
+* Desktop patch(PicoAide Harness):把 asar 归档**内部**的路径重写到 app.asar.unpacked。
+*
+* Electron 打包后 require.resolve 得到的是 resources/app.asar/node_modules/... 这样的
+* 归档内部路径;asar 是**文件**不是目录,原生二进制无法从里面 spawn(实测 ENOTDIR)。
+* 同一个二进制在 resources/app.asar.unpacked/ 下是一份真实文件(desktop 打包配置已把
+* bin/rg 与 bin/rg.exe 列入 asarUnpack),所以只要把它指过去就能跑。
+*
+* 仅在 unpacked 兄弟路径确实存在时重写;非打包环境(路径里没有 .asar 段)原样返回。
+* @param resolvedPath - require.resolve 得到的路径。
+* @returns 可被 spawn 的绝对路径。
+*/
+function unpackAsarPath(resolvedPath) {
+	const unpacked = resolvedPath.replace(/\.asar(?=[\\/])/u, ".asar.unpacked");
+	return unpacked !== resolvedPath && existsSync(unpacked) ? unpacked : resolvedPath;
+}
