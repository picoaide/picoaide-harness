    "@deepseek-ai/dsh-llm-deepseek@npm:^0.1.1-rc.2": "patch:@deepseek-ai/dsh-llm-deepseek@npm%3A0.1.1-rc.2#./patches/dsh-llm-deepseek@0.1.1-rc.2.patch",
    "@deepseek-ai/dsh-sandbox-windows-acl@npm:^0.1.1-rc.2": "patch:@deepseek-ai/dsh-sandbox-windows-acl@npm%3A0.1.1-rc.2#./patches/dsh-sandbox-windows-acl@0.1.1-rc.2.patch",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse@npm:^0.1.1-rc.2": "patch:@deepseek-ai/dsh-client-ui-directory-picker-browse@npm%3A0.1.1-rc.2#./patches/dsh-client-ui-directory-picker-browse@0.1.1-rc.2.patch",
    "@deepseek-ai/dsh-client-ui-brand-official@npm:^0.1.1-rc.2": "patch:@deepseek-ai/dsh-client-ui-brand-official@npm%3A0.1.1-rc.2#./patches/dsh-client-ui-brand-official@0.1.1-rc.2.patch",
    "koffi@npm:^3.1.0": "3.1.5",
    "@deepseek-ai/dsh-sandbox-windows-acl@npm:0.1.1-rc.2": "patch:@deepseek-ai/dsh-sandbox-windows-acl@npm%3A0.1.1-rc.2#./patches/dsh-sandbox-windows-acl@0.1.1-rc.2.patch",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse@npm:0.1.1-rc.2": "patch:@deepseek-ai/dsh-client-ui-directory-picker-browse@npm%3A0.1.1-rc.2#./patches/dsh-client-ui-directory-picker-browse@0.1.1-rc.2.patch",
    "@deepseek-ai/dsh-client-ui-brand-official@npm:0.1.1-rc.2": "patch:@deepseek-ai/dsh-client-ui-brand-official@npm%3A0.1.1-rc.2#./patches/dsh-client-ui-brand-official@0.1.1-rc.2.patch"
  },
  "dependenciesMeta": {
    "@ast-grep/cli": {
      "built": true
    },
    "@deepseek-ai/dsh-subprocess-local": {
      "built": true
    },
    "@google/genai": {
      "built": false
    },
    "electron": {
      "built": true
    },
    "electron-winstaller": {
      "built": false
    },
    "esbuild": {
      "built": true
    },
    "koffi": {
      "built": true
    },
    "node-pty": {
      "built": true
    },
    "protobufjs": {
      "built": false
    }
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3"
  },
  "scripts": {
    "build": "yarn workspace @picoaide/dsh-enterprise build && yarn workspace dsh-plugin-desktop build",
    "typecheck": "yarn workspace @picoaide/dsh-enterprise typecheck && yarn workspace dsh-plugin-desktop typecheck",
    "test": "yarn workspace @picoaide/dsh-enterprise test && yarn workspace dsh-plugin-desktop test",
    "check:layout": "node scripts/verify-layout.mjs",
    "check": "yarn check:layout && yarn workspace dsh-plugin-desktop build && yarn workspace @picoaide/dsh-connectors check && yarn workspace @picoaide/dsh-enterprise check && yarn workspace @picoaide/dsh-account-card check && yarn workspace @picoaide/dsh-branding check && yarn workspace @picoaide/dsh-browser check && yarn workspace @picoaide/dsh-cron check && yarn workspace dsh-community-fabric check && yarn workspace dsh-plugin-desktop check",
    "dev": "yarn workspace dsh-plugin-desktop dev",
    "start": "yarn workspace dsh-plugin-desktop start",
    "package:dir": "yarn workspace dsh-plugin-desktop package:dir",
    "dist:mac": "yarn workspace dsh-plugin-desktop dist:mac",
    "dist:mac-smoke": "yarn workspace dsh-plugin-desktop dist:mac-smoke",
    "dist:win": "yarn workspace dsh-plugin-desktop dist:win",
    "dist:win-portable": "yarn workspace dsh-plugin-desktop dist:win-portable",
    "upstream:version": "cd deepseek-harness && corepack pnpm --version",
    "upstream:install": "cd deepseek-harness && corepack pnpm install --frozen-lockfile",
    "upstream:build": "cd deepseek-harness && corepack pnpm run build",
    "build:connectors": "yarn workspace @picoaide/dsh-connectors build",
    "typecheck:connectors": "yarn workspace @picoaide/dsh-connectors typecheck",
    "test:connectors": "yarn workspace @picoaide/dsh-connectors test",
    "dist:linux": "yarn workspace dsh-plugin-desktop dist:linux",
    "version": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check"
  }
}
