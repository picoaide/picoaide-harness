{
  "name": "picoaide-harness",
  "version": "2.6.9-beta.2",
  "private": true,
  "description": "PicoAide Harness product workspace",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*/*",
    "community/*"
  ],
  "resolutions": {
    "app-builder-lib@npm:26.15.3": "patch:app-builder-lib@npm%3A26.15.3#./patches/app-builder-lib@26.15.3.patch",
    "@deepseek-ai/dsh-llm-deepseek@npm:^0.1.2-rc.1": "patch:@deepseek-ai/dsh-llm-deepseek@npm%3A0.1.2-rc.1#./patches/dsh-llm-deepseek@0.1.2-rc.1.patch",
    "@deepseek-ai/dsh-llm-deepseek@npm:0.1.2-rc.1": "patch:@deepseek-ai/dsh-llm-deepseek@npm%3A0.1.2-rc.1#./patches/dsh-llm-deepseek@0.1.2-rc.1.patch",
    "@deepseek-ai/dsh-win32-process@npm:^0.1.2-rc.1": "patch:@deepseek-ai/dsh-win32-process@npm%3A0.1.2-rc.1#./patches/dsh-win32-process@0.1.2-rc.1.patch",
    "@deepseek-ai/dsh-client-ui-brand-official@npm:^0.1.2-rc.1": "patch:@deepseek-ai/dsh-client-ui-brand-official@npm%3A0.1.2-rc.1#./patches/dsh-client-ui-brand-official@0.1.2-rc.1.patch",
    "koffi@npm:^3.1.0": "3.1.5",
    "@deepseek-ai/dsh-win32-process@npm:0.1.2-rc.1": "patch:@deepseek-ai/dsh-win32-process@npm%3A0.1.2-rc.1#./patches/dsh-win32-process@0.1.2-rc.1.patch",
    "@deepseek-ai/dsh-client-ui-brand-official@npm:0.1.2-rc.1": "patch:@deepseek-ai/dsh-client-ui-brand-official@npm%3A0.1.2-rc.1#./patches/dsh-client-ui-brand-official@0.1.2-rc.1.patch",
    "@deepseek-ai/dsh-agent-presets@npm:0.1.2-rc.1": "patch:@deepseek-ai/dsh-agent-presets@npm%3A0.1.2-rc.1#./patches/dsh-agent-presets@0.1.2-rc.1.patch",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek@npm:0.1.2-rc.1": "patch:@deepseek-ai/dsh-plugin-package-inventory-deepseek@npm%3A0.1.2-rc.1#./patches/dsh-plugin-package-inventory-deepseek@0.1.2-rc.1.patch"
  },
  "dependenciesMeta": {
    "@deepseek-ai/dsh-subprocess-local": {
      "built": true
    },
    "@google/genai": {
      "built": false
    },
    "electron": {
      "built": true
    },
    "electron-winstaller": {
      "built": false
    },
    "esbuild": {
      "built": true
    },
    "koffi": {
      "built": true
    },
    "node-pty": {
      "built": true
    },
    "protobufjs": {
      "built": false
    }
  },
  "scripts": {
    "build": "yarn workspace @picoaide/dsh-enterprise build && yarn workspace dsh-plugin-desktop build",
    "typecheck": "yarn workspace @picoaide/dsh-enterprise typecheck && yarn workspace dsh-plugin-desktop typecheck",
    "test": "yarn workspace @picoaide/dsh-enterprise test && yarn workspace dsh-plugin-desktop test",
    "check:layout": "node scripts/verify-layout.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:ci-scripts": "node scripts/verify-ci-scripts.mjs",
    "prebuild": "yarn workspace dsh-plugin-desktop prebuild",
    "check": "node scripts/check-workspaces.mjs",
    "check:fast": "node scripts/check-workspaces.mjs --changed",
    "dev": "yarn workspace dsh-plugin-desktop dev",
    "start": "yarn workspace dsh-plugin-desktop start",
    "package:dir": "yarn workspace dsh-plugin-desktop package:dir",
    "dist:mac": "yarn workspace dsh-plugin-desktop dist:mac",
    "dist:mac-smoke": "yarn workspace dsh-plugin-desktop dist:mac-smoke",
    "dist:win": "yarn workspace dsh-plugin-desktop dist:win",
    "dist:win-portable": "yarn workspace dsh-plugin-desktop dist:win-portable",
    "upstream:version": "cd deepseek-harness && corepack pnpm --version",
    "upstream:install": "cd deepseek-harness && corepack pnpm install --frozen-lockfile",
    "upstream:build": "cd deepseek-harness && corepack pnpm run build",
    "build:connectors": "yarn workspace @picoaide/dsh-connectors build",
    "typecheck:connectors": "yarn workspace @picoaide/dsh-connectors typecheck",
    "test:connectors": "yarn workspace @picoaide/dsh-connectors test",
    "dist:linux": "yarn workspace dsh-plugin-desktop dist:linux",
    "version": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
