.DS_Store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
node_modules/
*.tsbuildinfo
.build/

# DSH plugin packages: build output (lib/) is never committed — every workspace
# member compiles to lib/ at build time (tsdown/tsc) and packaging pre-builds
# deps (packages/host/desktop/scripts/prebuild-workspace-deps.ts).
packages/host/desktop/dist/
packages/host/desktop/lib/
# desktop build 生成图标(scripts/generate-*.mjs 从 logo.svg/tray-icon.svg 派生),
# 仅源文件(app-icon.png/tray-icon.svg/assistedMessages.yml)入库。
packages/host/desktop/build/app-icon-mac.png
packages/host/desktop/build/tray-icon*.png
packages/host/enterprise/lib/
packages/client/account-card/lib/
packages/client/branding/lib/
packages/host/cron/lib/
packages/host/connectors/lib/
packages/host/browser/lib/
packages/client/better-sidebar/lib/
# dsh-memory-evolve 是 git submodule(独立仓库 github:csyangwen/dsh-memory-evolve),
# 其 lib/ 在子仓库内跟踪,主仓库只记录 submodule pin。
community/market/lib/

# server (Go)
server/bin/
server/data/
server/*.db
server/*.db-wal
server/*.db-shm
server/webadmin/node_modules/
server/webadmin/dist/*
!server/webadmin/dist/.gitkeep
server/webadmin/tsconfig.tsbuildinfo
*.log
.yarn/cache
.research/
.yarn-cache/
.yarn-home/

# local tooling artifacts
.audit/
.go-cache/
.go-path/
.npm-cache/
.smoke/

# ephemeral scratch / agent-skill planning dirs (never committed)
temp/
.agents/skills/

# local writable DSH home mirror (this sandbox root fs is read-only)
.dsh-home/

# Client E2E runtime artifacts
packages/host/desktop/.e2e-report.md
packages/host/desktop/.e2e-shots/
packages/host/desktop/.real-env-report.md
packages/host/desktop/.real-env-shots/
packages/host/desktop/.real-env-cron-report.md
packages/host/desktop/.real-env-cron-shots/
packages/host/desktop/.real-env-cron-flow-report.md
packages/host/desktop/.real-env-cron-flow-shots/
packages/host/desktop/.real-env-browser-report.md
packages/host/desktop/.real-env-browser-shots/
# better-sidebar 构建 sourcemap（历史零入库；lib/*.js 本体入库）
packages/client/better-sidebar/lib/*.map

# CodeQL scan artifacts (rebuilt per audit round; not source)
.codeql-dbs/
temp/gopath/
temp/gocache/
temp/gomodcache/
temp/xdgcache/
.tmp-gocache/
