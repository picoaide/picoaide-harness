.DS_Store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
node_modules/
*.tsbuildinfo
.build/

# DSH plugin packages: build output is never committed for workspace members
# that compile to lib/ (desktop, enterprise, account-card, branding) unless a
# member intentionally ships it (dsh-browser, dsh-connectors, dsh-cron,
# dsh-task and dsh-memory-evolve track lib/ for the packaged runtime).
packages/host/desktop/dist/
packages/host/desktop/lib/
packages/host/enterprise/lib/
packages/client/account-card/lib/
packages/client/branding/lib/
community/market/lib/

# server (Go)
server/bin/
server/data/
server/*.db
server/*.db-wal
server/*.db-shm
server/webadmin/node_modules/
server/webadmin/dist/*
!server/webadmin/dist/index.html
server/webadmin/tsconfig.tsbuildinfo
*.log
.yarn/cache
.research/
.yarn-cache/
.yarn-home/

# local tooling artifacts
.audit/
.go-cache/
.go-path/
.npm-cache/
.smoke/

# local writable DSH home mirror (this sandbox root fs is read-only)
.dsh-home/
