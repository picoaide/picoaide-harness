# ============================================================
# PicoAide Harness 服务端部署配置样例
# 用法: cp .env.example .env 然后修改必填项(务必改密码!)
# 也可由 scripts/deploy.sh install 自动生成(推荐)
# ============================================================
# 只有以下 4 个键需要配置,其余全部在 docker-compose.yml 内置默认值
# (SERVER_IMAGE 可选,见文末)。

# ---- 必填 ----
# 对外域名或 IP(访问地址,如 picoaide.example.com 或 10.0.0.5)
DOMAIN=picoaide.example.com

# 初始管理员密码(首次启动创建 admin;已有 admin 后幂等跳过,可置空清除明文)
PICOAI_ADMIN_PASSWORD=change-me-to-a-strong-password

# 内置 PostgreSQL 容器密码(首次部署时创建;请改成强密码)
PG_PASSWORD=change-me-to-a-strong-password

# 证书模式(三选一,重要):
#   manual   = 手动证书: 使用 certs/server.crt + certs/server.key(缺省由部署脚本/openssl 生成自签占位,
#              正式证书替换:覆盖 certs/ 下两文件 → docker compose restart caddy)
#   auto     = 自动证书: Caddy 自动申请/续期 Let's Encrypt(需公网域名直连本机,80/443 对外开放;
#              域名经 CDN 时安装脚本会要求人工确认,或直接选用 manual)
#   internal = 本地自签: Caddy 本地 CA 签发(tls internal),纯内网/无公网域名开箱即用
TLS_MODE=manual

# ---- 可选(均有默认值,一般不用改) ----
# 服务端镜像(可用自己的私有 registry 地址;发布流程见 docs/02-build-deploy.md)
# SERVER_IMAGE=ghcr.io/picoaide/picoaide-harness-server:latest

# 私有网段与容器固定 IP(与宿主机其他网段冲突时改这里)
# NETWORK_SUBNET=172.28.0.0/24
# CADDY_IP=172.28.0.2
# SERVER_IP=172.28.0.3
# PG_IP=172.28.0.4

# 可信反向代理(审计 2026-08-25 F-02):登录限流据此解析真实客户端 IP,
# 防反代后限流键坍缩为单一代理 IP(单账号 DoS);改网段时应同步 CADDY_IP。
# 本地直连(无 Caddy)可留空。
# PICOAI_TRUSTED_PROXIES=172.28.0.2

# Caddy 宿主机端口映射(改端口时需同步修改 Caddyfile;一般不用动)
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# 时区
# TZ=Asia/Shanghai

# 主密钥(可选,强烈建议备份):留空则服务端首次启动自动生成 data/master.key
# PICOAI_MASTER_KEY=
