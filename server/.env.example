# ============================================================
# PicoAide 服务端部署配置样例
# 用法: cp .env.example .env 然后修改必填项(务必改密码!)
# 也可由 scripts/deploy.sh install 自动生成(推荐)
# ============================================================

# ---- 域名与证书 ----
# 对外域名或 IP(访问地址,如 picoaide.example.com 或 10.0.0.5)
DOMAIN=picoaide.example.com

# 证书模式(二选一,重要):
#   manual = 手动证书: 使用 certs/server.crt + certs/server.key(缺省由部署脚本/openssl 生成自签占位,
#            正式证书替换:覆盖 certs/ 下两文件 → docker compose restart caddy)
#   auto   = 自动证书: Caddy 自动申请/续期 Let's Encrypt(需公网域名直连本机,80/443 对外开放;
#            域名经 CDN 时安装脚本会要求人工确认,或直接选用 manual)
TLS_MODE=manual

# ---- 初始管理员(首次启动创建,已有 admin 后幂等跳过;可置空清除明文) ----
ADMIN_USER=admin
PICOAI_ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- 镜像与网络 ----
# 服务端镜像(可用自己的私有 registry 地址;发布流程见 docs/02-build-deploy.md)
SERVER_IMAGE=ghcr.io/picoaide/picoaide-server:latest

# 私有网段(自定义 bridge docker 网络;与宿主机其他网段冲突时改这里)
NETWORK_SUBNET=172.28.0.0/24
# 容器固定 IP(重建/升级后不变;需在子网范围内,如 172.28.0.0/24 → .2/.3)
CADDY_IP=172.28.0.2
SERVER_IP=172.28.0.3

# ---- 容器运行参数(可选) ----
TZ=Asia/Shanghai
# Caddy 宿主机端口映射(改端口时需同步修改 Caddyfile;一般不用动)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---- 主密钥(可选,强烈建议备份) ----
# 留空:服务端首次启动自动生成 data/master.key(已加密凭证的解密密钥,丢失不可恢复)
# 或显式指定 32 字节密钥(hex/base64,按 internal/util/crypto.go parseKey 规则)
PICOAI_MASTER_KEY=
