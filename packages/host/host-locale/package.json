{
  "name": "@picoaide/dsh-host-locale",
  "version": "0.1.0",
  "description": "Host-side UI locale for PicoAide Harness: locale resolution and copy selection for host surfaces that cannot reach the client-face ctx.locale service",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./loopback": {
      "types": "./lib/types/loopback.d.ts",
      "default": "./lib/loopback.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "yarn run build && yarn run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
