{
  "name": "@picoaide/dsh-wasm-apps-host",
  "version": "0.1.0",
  "description": "WASM app platform host face: the picoaide-app:// origin handler plus the /api/pico/apps/wasm* app-store routes and wasm_app_* tools",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./app-proof": {
      "types": "./lib/types/app-proof.d.ts",
      "default": "./lib/app-proof.js"
    },
    "./windows": {
      "types": "./lib/types/windows.d.ts",
      "default": "./lib/windows.js"
    },
    "./host-request": {
      "types": "./lib/types/host-request.d.ts",
      "default": "./lib/host-request.js"
    },
    "./ai-chat": {
      "types": "./lib/types/ai-chat.d.ts",
      "default": "./lib/ai-chat.js"
    },
    "./electron-adapter": {
      "types": "./lib/types/electron-adapter.d.ts",
      "default": "./lib/electron-adapter.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "yarn run build && yarn run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@picoaide/dsh-browser": "workspace:*",
    "@picoaide/dsh-gateway-client": "workspace:*",
    "@picoaide/dsh-host-home": "workspace:*",
    "@picoaide/dsh-host-locale": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "electron": "44.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "electron": "44.0.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
