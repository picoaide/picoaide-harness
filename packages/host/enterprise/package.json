{
  "name": "@picoaide/dsh-enterprise",
  "version": "0.1.0",
  "description": "Enterprise login + server-side LLM gateway for PicoAide Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./auth-gate": {
      "types": "./lib/types/auth-gate.d.ts",
      "default": "./lib/auth-gate.js"
    },
    "./channel-sync": {
      "types": "./lib/types/channel-sync.d.ts",
      "default": "./lib/channel-sync.js"
    },
    "./gateway-model": {
      "types": "./lib/types/gateway-model.d.ts",
      "default": "./lib/gateway-model.js"
    },
    "./gateway-llm": {
      "types": "./lib/types/gateway-llm.d.ts",
      "default": "./lib/gateway-llm.js"
    },
    "./bootstrap": {
      "types": "./lib/types/bootstrap.d.ts",
      "default": "./lib/bootstrap.js"
    },
    "./error-reporting": {
      "types": "./lib/types/error-reporting.d.ts",
      "default": "./lib/error-reporting.js"
    },
    "./skill-telemetry": {
      "types": "./lib/types/skill-telemetry.d.ts",
      "default": "./lib/skill-telemetry.js"
    },
    "./session-identity": {
      "types": "./lib/types/session-identity.d.ts",
      "default": "./lib/session-identity.js"
    },
    "./session-service": {
      "types": "./lib/types/session-service.d.ts",
      "default": "./lib/session-service.js"
    },
    "./server-connector/auth": {
      "types": "./lib/types/server-connector/auth.d.ts",
      "default": "./lib/server-connector/auth.js"
    },
    "./loopback": {
      "types": "./lib/types/loopback.d.ts",
      "default": "./lib/loopback.js"
    },
    "./server-connector/config": {
      "types": "./lib/types/server-connector/config.d.ts",
      "default": "./lib/server-connector/config.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "../../../cordis.patch.yml",
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-theme",
        "@picoaide/dsh-foot-menu"
      ],
      "platform": "web"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "check": "yarn run build && yarn run test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@picoaide/dsh-host-locale": "workspace:*",
    "@sentry/node": "^7.120.0",
    "adm-zip": "^0.6.0",
    "tar": "^7.5.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@picoaide/dsh-foot-menu": "workspace:*",
    "@picoaide/dsh-panel-surface": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "^18",
    "dsh-plugin-desktop": "workspace:*",
    "electron": "45.0.0-alpha.7",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
