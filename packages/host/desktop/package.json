        "!**/node_modules/@img/sharp-win32-*/**",
        "!**/node_modules/@img/sharp-libvips-win32-*/**",
        "!**/node_modules/@img/sharp-freebsd-*/**",
        "!**/node_modules/@img/sharp-webcontainers-*/**",
        "!**/node_modules/@vscode/ripgrep-linux-arm*/**",
        "!**/node_modules/@vscode/ripgrep-darwin-*/**",
        "!**/node_modules/@vscode/ripgrep-win32-*/**",
        "!**/node_modules/@vscode/ripgrep-linux-ppc64/**",
