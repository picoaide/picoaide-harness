    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "icon": "build/app-icon-mac.png",
      "artifactName": "PicoAide-Harness-${version}-mac.${ext}",
      "mergeASARs": false,
      "notarize": true,
      "x64ArchFiles": "{**/node_modules/{node-pty/prebuilds/darwin-*/**,node-addon-require-builtin-darwin-*/**,@vscode/ripgrep-darwin-*/**,@img/sharp-darwin-*/**,@img/sharp-libvips-darwin-*/**,@koromix/koffi-darwin-*/**},**/Resources/cli/**}"
    },
    "win": {
