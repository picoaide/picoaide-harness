    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "PicoAide Harness",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "protocols": [
      {
        "name": "PicoAide Harness Deep Link",
        "schemes": [
          "picoaide"
        ]
      }
    ],
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/*.exe",
      "**/*.so*",
      "**/*.dylib",
      "**/bin/rg",
      "**/bin/rg.exe",
      "**/node_modules/@deepseek-ai/node-addon-landlock-run-*/bin/landlock-run",
      "**/prebuilds/**/spawn-helper",
      "**/prebuilds/**/OpenConsole.exe",
      "**/prebuilds/**/*.conpty_console_list*"
    ],
    "afterPack": "./scripts/verify-packaged-runtime.ts",
    "extraResources": [],
    "electronFuses": {
      "runAsNode": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/app-icon.png",
      "build/app-icon-mac.png",
      "build/tray-icon*.png",
      "cordis.patch.yml",
      "lib/**",
      "package.json",
      "!**/*.map",
      "!.e2e-*",
      "!.real-env-*",
      "!src/**",
      "!tests/**",
      "!scripts/**",
      "!docs/**",
      "!COVERAGE-MATRIX.md",
      "!tsconfig*.json",
      "!vitest.config.ts",
      "!*.ts",
      "!*.tsx",
      "!**/node_modules/dsh-better-sidebar/src/**",
      "!**/node_modules/dsh-better-sidebar/scripts/**",
      "!**/node_modules/dsh-better-sidebar/tests/**",
      "!**/node_modules/dsh-better-sidebar/node_modules/**",
      "!**/node_modules/dsh-memory-evolve/src/**",
      "!**/node_modules/dsh-memory-evolve/docs/**",
      "!**/node_modules/dsh-memory-evolve/skills/**",
      "!**/node_modules/dsh-memory-evolve/tests/**",
